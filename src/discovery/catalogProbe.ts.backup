import type { Page } from "playwright";
import type { MenuCandidate } from "./menuDiscovery.js";

export interface CatalogProbeResult {
  accepted: boolean;
  url: string;
  intent: MenuCandidate["inferredIntent"];
  title: string;
  productLikeLinks: number;
  paginationLinks: number;
  reason: string;
}

function norm(value: string): string {
  return String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/đ/g, "d")
    .replace(/Đ/g, "D")
    .toLowerCase()
    .replace(/\s+/g, " ")
    .trim();
}

async function resolveRootHref(
  page: Page,
  candidate: MenuCandidate
): Promise<string> {

  if (candidate.node.href) {
    return candidate.node.href;
  }

  const wanted =
    norm(
      candidate.node.text ||
      candidate.node.ariaLabel
    );

  if (!wanted) {
    return "";
  }

  const href = await page.evaluate(
    (wantedText) => {

      const normalize = (value: string) =>
        String(value || "")
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/đ/g, "d")
          .replace(/Đ/g, "D")
          .toLowerCase()
          .replace(/\s+/g, " ")
          .trim();

      const origin =
        window.location.origin;

      const anchors = [
        ...document.querySelectorAll<HTMLAnchorElement>(
          "a[href]"
        )
      ];

      const scored = anchors
        .map(a => {

          const ownText =
            normalize(
              a.innerText ||
              a.textContent ||
              ""
            );

          const title =
            normalize(
              a.getAttribute("title") || ""
            );

          const aria =
            normalize(
              a.getAttribute(
                "aria-label"
              ) || ""
            );

          const href =
            a.href || "";

          let score = 0;

          if (ownText === wantedText) {
            score += 200;
          }

          if (title === wantedText) {
            score += 120;
          }

          if (aria === wantedText) {
            score += 120;
          }

          if (
            ownText.includes(
              wantedText
            )
          ) {
            score += 40;
          }

          try {
            const u =
              new URL(href);

            if (
              u.origin === origin
            ) {
              score += 30;
            }

            if (
              u.pathname !== "/" &&
              u.pathname.length > 1
            ) {
              score += 20;
            }

          } catch {}

          return {
            href,
            score,
            text: ownText
          };
        })
        .filter(
          x =>
            x.href &&
            x.score > 0
        )
        .sort(
          (a, b) =>
            b.score - a.score
        );

      return scored[0]?.href || "";
    },
    wanted
  );

  return href;
}

export async function probeCatalogRoot(
  page: Page,
  candidate: MenuCandidate
): Promise<CatalogProbeResult> {

  const resolvedUrl =
    await resolveRootHref(
      page,
      candidate
    );

  if (!resolvedUrl) {
    return {
      accepted: false,
      url: "",
      intent:
        candidate.inferredIntent,
      title: "",
      productLikeLinks: 0,
      paginationLinks: 0,
      reason:
        "No catalog href could be resolved from DOM"
    };
  }

  const probe =
    await page.context()
      .newPage();

  try {

    await probe.goto(
      resolvedUrl,
      {
        waitUntil:
          "domcontentloaded",
        timeout: 45000
      }
    );

    await probe.waitForTimeout(
      1000
    );

    const title =
      await probe.title();

    const scan =
      await probe.evaluate(() => {

        const clean =
          (v: unknown) =>
            String(v || "")
              .replace(
                /\s+/g,
                " "
              )
              .trim();

        const anchors = [
          ...document
            .querySelectorAll<
              HTMLAnchorElement
            >("a[href]")
        ];

        let productLikeLinks = 0;
        let paginationLinks = 0;

        for (
          const a of anchors
        ) {

          const text =
            clean(
              a.innerText ||
              a.textContent ||
              ""
            );

          const href =
            a.href || "";

          const parentText =
            clean(
              a.parentElement
                ?.innerText || ""
            );

          const hasBrand =
            /\b(canon|sony|nikon|fujifilm|fuji|lumix|panasonic|olympus|leica|ricoh|pentax|gopro|dji|insta360)\b/i
              .test(text);

          const hasPriceNearby =
            /\b\d{1,3}(?:[.,]\d{3})+(?:\s*)?(?:đ|₫|vnd)\b/i
              .test(
                parentText
              );

          if (
            href &&
            hasBrand &&
            hasPriceNearby
          ) {
            productLikeLinks++;
          }

          if (
            /^(next|last|prev|previous|\d+)$/i
              .test(text) ||
            /[?&](p|page)=\d+/i
              .test(href)
          ) {
            paginationLinks++;
          }
        }

        const bodyText =
          clean(
            document.body
              .innerText
          );

        return {
          productLikeLinks,
          paginationLinks,
          bodyText
        };
      });

    const body =
      norm(scan.bodyText);

    let intentEvidence = true;

    if (
      candidate.inferredIntent ===
      "SECOND_HAND"
    ) {
      intentEvidence =
        /may anh cu|hang cu|99%|second hand|used/
          .test(body);
    }

    if (
      candidate.inferredIntent ===
      "NEW"
    ) {
      intentEvidence =
        /chinh hang|new 100%|may anh moi/
          .test(body);
    }

    if (
      candidate.inferredIntent ===
      "RENTAL"
    ) {
      intentEvidence =
        /gia thue|cho thue|ngay nhan|ngay tra|rental/
          .test(body);
    }

    const hasCameraHeading =
      /may anh|camera/
        .test(body);

    const hasMoney =
      /\d{1,3}(?:[.,]\d{3})+\s*(?:đ|₫|vnd)/
        .test(body);

    const accepted =
      hasCameraHeading &&
      hasMoney &&
      intentEvidence;

    return {
      accepted,
      url:
        probe.url(),
      intent:
        candidate.inferredIntent,
      title,
      productLikeLinks:
        scan.productLikeLinks,
      paginationLinks:
        scan.paginationLinks,
      reason:
        accepted
          ? "Commercial camera catalog confirmed"
          : "Catalog evidence insufficient"
    };

  } finally {
    await probe.close();
  }
}
